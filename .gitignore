# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# --- Virtual environment (recreated by setup.sh / setup.bat) ---
.venv/
venv/
env/

# --- Numba JIT cache ---
*.nbi
*.nbc

# --- Generated run output (data, figures, logs) ---
# Regenerated by running the sweep; can be very large at high N. If you want to
# publish a specific figure or CSV, force-add it: `git add -f output/that_file`.
# --- Generated run output (data, figures, logs) ---
# Ignore absolutely everything inside the output directory and all subdirectories
output/**

# Allow Git to look inside the directory structures to find files
!output/**/

# Whitelist ONLY .png files everywhere inside output/
!output/**/*.png
!output/*.png

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Native engine builds (compiled per-machine with -march=native; never commit)
*.so
*.o
engines/**/target/
