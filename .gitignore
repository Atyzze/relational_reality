# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# --- Virtual environment (recreated by setup.sh / setup.bat) ---
.venv/
venv/
env/

# --- Numba JIT cache ---
*.nbi
*.nbc

# --- Generated run output (data, figures, logs) ---
# Regenerated by running the sweep; can be very large at high N. If you want to
# publish a specific figure or CSV, force-add it: `git add -f output/that_file`.
output/
!output/*.png

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
